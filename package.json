{
  "name": "torre-futbol",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "audit:data": "node scripts/audit-data-quality.js",
    "import:career": "node scripts/import-career-transfermarkt.js",
    "import:career:second": "node scripts/import-career-transfermarkt.js --second-divisions",
    "test:smoke": "node scripts/smoke-test.js",
    "test:smoke:prod": "node scripts/smoke-production.js",
    "start": "node -r ./viewport-fit-server.js server.js",
    "audit:tournaments": "node scripts/audit-tournaments.js",
    "optimize:assets": "node scripts/optimize-assets.js",
    "audit:assets": "node scripts/audit-asset-priorities.js",
    "audit:aliases": "node scripts/audit-aliases.js",
    "verify:deploy": "node scripts/verify-deploy.js",
    "verify:prod": "node scripts/verify-production.js",
    "compact:career-data": "node scripts/compact-career-data.js",
    "check:js": "node scripts/check-javascript.js",
    "audit:security": "npm audit --omit=dev --audit-level=high",
    "test:release": "npm run check:js && npm run audit:security && npm run verify:deploy && npm run audit:data && npm run audit:tournaments && npm run audit:assets && npm run audit:aliases && npm run test:smoke"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "express": "^4.18.3",
    "playwright": "^1.60.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3"
  }
}
